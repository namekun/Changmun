"You stopped the import, so the browsers after these were not imported." = "Detuviste la importación, así que los navegadores siguientes no se importaron.";
"⇧-click" = "⇧-clic";
"⇧⌘-click" = "⇧⌘-clic";
"⌘-click or middle-click" = "⌘-clic o clic con el botón central";
"⌘L searches and goes anywhere." = "⌘L busca y te lleva a cualquier parte.";
"⌘Return in the search field" = "⌘Intro en el campo de búsqueda";
"⌘T opens the search bar over a blank page." = "⌘T abre la barra de búsqueda sobre una página en blanco.";

/* Start page */
"A private window always shows its own start page, whatever is set here." = "Una ventana privada siempre muestra su propia página de inicio, sea cual sea el ajuste.";
"A private window can't be shown to the AI, so the AI panel and its suggestions don't appear here." = "Una ventana privada no puede mostrarse a la IA, así que aquí no aparecen el panel de IA ni sus sugerencias.";
"Address for new tabs" = "Dirección para pestañas nuevas";
"Blank Page" = "Página en blanco";
"Drag the sites you visit most to the favorites in the sidebar and they appear here as tiles." = "Arrastra los sitios que más visitas a los favoritos de la barra lateral y aparecerán aquí como mosaicos.";
"History, the session, cookies and site data are erased when you close the window. Search suggestions aren't sent either." = "El historial, la sesión, las cookies y los datos de los sitios se borran al cerrar la ventana. Tampoco se envían sugerencias de búsqueda.";
"It isn't anonymous" = "No es anónimo";
"Leave it empty to open the start page." = "Déjala vacía para abrir la página de inicio.";
"New Tabs Open" = "Las pestañas nuevas abren";
"No bookmarks found in that file" = "No se encontraron marcadores en ese archivo";
"Nothing is kept" = "No se guarda nada";
"Start Page" = "Página de inicio";
